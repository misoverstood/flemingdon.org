    "type": "quote",
    "attribution": "",
    "source": "",
    "album": "",
    "year": null,
    "genius_id": "",
    "tmdb_id": "",
    "wiki_title": "",
    "openlibrary_id": "",
    "note": "",
    "skip": false
  },
